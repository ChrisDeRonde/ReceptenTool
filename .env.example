# Database. SQLite is prima voor twee gebruikers; wissel later naar Postgres
# door provider in prisma/schema.prisma aan te passen.
DATABASE_URL="file:./dev.db"

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Model dat het recept uit de ruwe tekst haalt.
RECIPE_MODEL="claude-opus-5"

# Gedeeld geheim voor de ingest-endpoint (/api/share).
# Genereer bijv. met: openssl rand -hex 32
# Dit token zet je in de iOS Shortcut / Share Extension.
INGEST_TOKEN="verander-dit-in-een-lang-random-token"

# Publieke basis-URL van de app (voor links in de Shortcut-respons).
APP_BASE_URL="http://localhost:3000"
