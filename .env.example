# Database. SQLite is prima voor twee gebruikers; wissel later naar Postgres
# door provider in prisma/schema.prisma aan te passen.
DATABASE_URL="file:./dev.db"

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Model dat het recept uit de ruwe tekst haalt.
RECIPE_MODEL="claude-opus-5"

# Wachtwoord voor de web-UI. Zonder dit blijft de hele app op slot — pagina's
# én server actions, want die laatste kunnen recepten verwijderen en kosten
# geld (een modelaanroep per import). Minstens 8 tekens.
# Verander je dit, dan moet iedereen opnieuw inloggen.
APP_PASSWORD="verzin-hier-iets-dat-jullie-allebei-onthouden"

# Wie gebruiken de app? Komma-gescheiden. Na het inloggen vraagt de app één
# keer wie je bent, en die naam komt bij je oordeel in de kooklog, bij wat je
# importeert en bij wat je bewerkt.
# Dit is nadrukkelijk geen tweede wachtwoord: iedereen kan elke naam kiezen en
# wisselen kost één tik. Het slot is APP_PASSWORD hierboven.
# Laat je dit leeg, dan vraagt de app niets en blijft alles naamloos.
# Je kunt de namen ook in de app zelf zetten (Ik → Instellingen); zodra je dat
# doet neemt de app het over en wordt deze regel niet meer gelezen.
APP_USERS="Chris,Sanne"

# Gedeeld geheim voor de ingest-endpoint (/api/share).
# Genereer bijv. met: openssl rand -hex 32
# Dit token zet je in de iOS Shortcut / Share Extension.
INGEST_TOKEN="verander-dit-in-een-lang-random-token"

# Publieke basis-URL van de app (voor links in de Shortcut-respons).
# Begint dit met https://, dan krijgt het inlogkoekje de Secure-vlag.
APP_BASE_URL="http://localhost:3000"


# --- Back-up (optioneel) ---------------------------------------------------

# Waar `npm run db:backup` zijn mappen neerzet. Standaard ./backups.
# Wijs dit naar een aangekoppelde schijf als je die hebt.
# BACKUP_DIR="/mnt/backup/recepten"

# Hoeveel runs blijven staan. Standaard 14.
# BACKUP_KEEP="14"


# --- Scraper (optioneel) ---------------------------------------------------

# Pagina's renderen in een echte browser als de HTML te weinig oplevert.
# Nodig voor sites die hun recept pas met JavaScript opbouwen; de meeste
# receptensites hebben dat niet nodig. Vereist:
#   npm install playwright && npx playwright install chromium
# SCRAPER_BROWSER="1"

# Gebruik playwright-core in plaats van playwright (downloadt geen browsers).
# SCRAPER_BROWSER_MODULE="playwright-core"

# Pad naar een al aanwezige Chromium, in plaats van er een te laten downloaden.
# SCRAPER_BROWSER_EXECUTABLE="/usr/bin/chromium"

# Instagram-embeds via een eigen proxy halen. Handig als Instagram het IP van
# je server blokkeert; wijs dit naar iets dat /p/<code>/embed/captioned/ doorzet.
# INSTAGRAM_EMBED_BASE="https://www.instagram.com"
