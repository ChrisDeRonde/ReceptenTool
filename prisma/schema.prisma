generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Alles wat via de share sheet binnenkomt landt hier eerst, ongeacht of we er
/// een recept van kunnen maken. Zo raakt er nooit iets kwijt en kun je een
/// mislukte verwerking opnieuw draaien zonder opnieuw te delen.
model ShareItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// pending | processing | done | failed | needs_input | duplicate
  status String @default("pending")

  /// instagram | ah | website | text | foto
  sourceType String
  sourceUrl  String?
  /// Tekst die is meegedeeld (Instagram-caption, geplakt recept, notitie).
  sharedText String?
  /// Wie het deelde — vrij tekstveld, handig om te zien wie wat opsloeg.
  sharedBy   String?

  /// Gefotografeerde bron: JSON-array van { name, mime }. De bestanden zelf
  /// staan op schijf (zie src/lib/photos.ts), hier staat alleen de verwijzing.
  photos String?

  /// De opgehaalde platte tekst waar het model op werkt. Bewaard voor debugging
  /// en om opnieuw te kunnen parsen zonder de bron nogmaals te bevragen.
  rawText String?
  error   String?

  /// Welke ophaalstrategie het uiteindelijk deed, bijv. "instagram-embed" of
  /// "web-desktop+jsonld".
  strategy String?
  /// Het volledige spoor van geprobeerde strategieën, als JSON-array.
  attempts String?

  recipe Recipe? @relation("Bron")

  /// Het recept dat hier al op leek. Gezet als dit item op `duplicate` staat.
  duplicateOfId String?
  duplicateOf   Recipe? @relation("Duplicaat", fields: [duplicateOfId], references: [id], onDelete: SetNull)

  /// De modeluitvoer die klaarstaat terwijl jij beslist of het echt een
  /// duplicaat is. Zo kost "toch toevoegen" geen tweede modelaanroep.
  pendingData String?

  @@index([status, createdAt])
}

model Recipe {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  sourceUrl   String?
  sourceName  String?
  imageUrl    String?

  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  totalMinutes Int?

  /// Volledige gestructureerde inhoud (ingrediëntgroepen, stappen, tips) als
  /// JSON. Zie src/lib/recipe/schema.ts voor de vorm.
  data String
  /// Komma-gescheiden tags; SQLite kent geen array-type.
  tags String @default("")

  /// Wanneer je dit eet: komma-gescheiden waarden uit MEAL_TYPES. Een gerecht
  /// mag er meerdere hebben — soep is lunch én diner.
  mealTypes String  @default("")
  /// Uit welke keuken het komt, bijv. "Italiaans". Kolom in plaats van een
  /// veld in `data`, omdat er op gefilterd wordt.
  cuisine   String?

  /// Dieetkenmerken: komma-gescheiden waarden uit DIETS. Een inschatting op
  /// basis van de ingrediënten, geen keurmerk — zie src/lib/recipe/categories.ts.
  /// Leeg betekent "niet vastgesteld", niet "bevat alles".
  diets String @default("")

  favorite Boolean @default(false)

  /// Wanneer je het recept zelf hebt bijgewerkt. Null betekent: nog precies
  /// zoals het uit de bron kwam. Staat hier zodat de app kan waarschuwen
  /// voordat opnieuw verwerken die aanpassingen overschrijft.
  editedAt DateTime?
  /// Wie dat deed, als er een naam gekozen was. Zie src/lib/who.ts.
  editedBy String?

  menuEntries MenuEntry[]
  cookLogs    CookLog[]
  freezer     FreezerItem[]

  shareItemId String?    @unique
  shareItem   ShareItem? @relation("Bron", fields: [shareItemId], references: [id], onDelete: SetNull)

  /// Items die als duplicaat van dit recept zijn aangemerkt.
  duplicateItems ShareItem[] @relation("Duplicaat")

  @@index([createdAt])
}

/// Eén gerecht op één dag.
///
/// Het weekmenu is niets anders dan een verzameling hiervan; er is geen
/// "week"-object, want een week is maar een manier van kijken naar dagen.
model MenuEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// De dag zelf, op middernacht. Geen tijdstip: we plannen geen etenstijd.
  date DateTime

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// Voor hoeveel personen je het die dag maakt. Null betekent: zoals het
  /// recept het bedoelde.
  servings Int?

  /// Wie er kookt. Null als het niet uitmaakt of nog niet verdeeld is.
  ///
  /// Een naam en geen verwijzing naar een tabel: het huishouden is een
  /// komma-lijst in de instellingen en geen `User`-model. Haal je iemand
  /// daaruit weg, dan blijft zijn naam hier staan — dat is beter dan een lege
  /// avond, want er is die dag wel degelijk gekookt.
  cook String?

  /// Hoeveel mensen er die avond bijkomen bovenop het huishouden.
  ///
  /// Apart van `servings` en niet erin verwerkt, want het zijn twee
  /// verschillende dingen: `servings` is "voor hoeveel maak ik het", gasten is
  /// "wie er zijn". Je wilt op het scherm kunnen zien dát er bezoek komt, ook
  /// als je toch voor zes kookt omdat er overblijft.
  guests Int @default(0)

  /// Wat je van de gasten moet weten: "Ilse eet geen vis".
  ///
  /// Vrije tekst en geen koppeling met de dieetvoorkeuren van het huishouden:
  /// een gast is geen huisgenoot, en voor één avond een profiel aanmaken is
  /// meer administratie dan het waard is.
  guestNote String?

  @@index([date])
}

/// Wat er in de vriezer ligt.
///
/// De goedkoopste maaltijd die je kunt plannen is er een die je al gekookt
/// hebt. Dubbel koken en de helft invriezen werkt alleen als je het niet
/// vergeet — en een la vol naamloze bakjes is precies hoe je het vergeet.
///
/// Aan een recept gekoppeld waar dat kan, maar de naam wordt óók opgeslagen:
/// gooi je het recept later weg, dan ligt dat bakje er nog steeds.
model FreezerItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Wat het is, zoals je het op het bakje zou schrijven.
  name String

  /// Hoeveel porties erin zitten.
  portions Int @default(1)

  /// Wanneer het de vriezer in ging.
  frozenAt DateTime

  /// Het recept waar het van kwam, als het er nog is.
  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  /// Wie het erin zette.
  addedBy String?

  @@index([frozenAt])
}

/// Iets dat je zelf op de boodschappenlijst zet.
///
/// Wc-papier, koffie, hondenbrokken. Ze horen bij de week en niet bij een
/// recept, want ze komen nergens uit voort — daarom een eigen tabel en geen
/// veld aan `MenuEntry`.
///
/// In de database en niet in de browser, anders dan het afvinken: dit is een
/// huishouden van twee, en wat de één toevoegt hoort de ander te zien staan
/// als hij in de winkel staat. Afvinken is van jouw kant van de winkel;
/// toevoegen is van jullie samen.
model ShoppingExtra {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// De maandag van de week waar dit bij hoort, op middernacht.
  week DateTime

  /// Wat je nodig hebt, in je eigen woorden.
  text String

  /// Wie het erbij zette. Null als er geen naamkaartje gekozen is.
  addedBy String?

  @@index([week])
}

/// Eén keer dat je dit gerecht hebt gemaakt.
///
/// Los van het recept, want het gaat niet over het recept maar over die avond:
/// hoe het uitpakte en of het een blijvertje is. Meerdere keren koken levert
/// meerdere regels op, en daaruit volgt vanzelf hoe vaak je iets eet en hoe
/// lang het geleden is.
model CookLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// De dag dat je het maakte, op middernacht.
  cookedAt DateTime

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// Eén tot vijf sterren. Null als je alleen wilde vastleggen dát je het maakte.
  rating Int?

  /// Eén regel: wat je anders deed, wat opviel.
  note String?

  /// Vaker eten? Null betekent: niet gezegd.
  again Boolean?

  /// Hoe lang het werkelijk duurde, van beginnen tot op tafel.
  ///
  /// De bron schat, en die schatting is er meestal naast. Na twee of drie keer
  /// koken weet de app het beter dan het recept; zie `werkelijkeDuur` in
  /// lib/recipe/duur.ts voor hoe daar één getal van gemaakt wordt.
  minutes Int?

  /// Wie dit vond. Null als er geen naam gekozen was; een oordeel zonder naam
  /// is nog steeds een oordeel.
  who String?

  @@index([recipeId, cookedAt])
}

/// Instellingen die je vanuit de app kunt wijzigen.
///
/// Sleutel-waardeparen en geen kolommen: er komen er af en toe eentje bij, en
/// dan wil je geen migratie voor een getal. Geheimen staan hier níét in — die
/// horen in .env, waar ze niet via een webformulier te wijzigen zijn.
model Setting {
  key   String @id
  value String
}
