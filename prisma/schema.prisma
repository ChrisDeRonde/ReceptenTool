generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Alles wat via de share sheet binnenkomt landt hier eerst, ongeacht of we er
/// een recept van kunnen maken. Zo raakt er nooit iets kwijt en kun je een
/// mislukte verwerking opnieuw draaien zonder opnieuw te delen.
model ShareItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// pending | processing | done | failed | needs_input
  status String @default("pending")

  /// instagram | ah | website | text | foto
  sourceType String
  sourceUrl  String?
  /// Tekst die is meegedeeld (Instagram-caption, geplakt recept, notitie).
  sharedText String?
  /// Wie het deelde — vrij tekstveld, handig om te zien wie wat opsloeg.
  sharedBy   String?

  /// Gefotografeerde bron: JSON-array van { name, mime }. De bestanden zelf
  /// staan op schijf (zie src/lib/photos.ts), hier staat alleen de verwijzing.
  photos String?

  /// De opgehaalde platte tekst waar het model op werkt. Bewaard voor debugging
  /// en om opnieuw te kunnen parsen zonder de bron nogmaals te bevragen.
  rawText String?
  error   String?

  /// Welke ophaalstrategie het uiteindelijk deed, bijv. "instagram-embed" of
  /// "web-desktop+jsonld".
  strategy String?
  /// Het volledige spoor van geprobeerde strategieën, als JSON-array.
  attempts String?

  recipe Recipe?

  @@index([status, createdAt])
}

model Recipe {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  sourceUrl   String?
  sourceName  String?
  imageUrl    String?

  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  totalMinutes Int?

  /// Volledige gestructureerde inhoud (ingrediëntgroepen, stappen, tips) als
  /// JSON. Zie src/lib/recipe/schema.ts voor de vorm.
  data String
  /// Komma-gescheiden tags; SQLite kent geen array-type.
  tags String @default("")

  /// Wanneer je dit eet: komma-gescheiden waarden uit MEAL_TYPES. Een gerecht
  /// mag er meerdere hebben — soep is lunch én diner.
  mealTypes String @default("")
  /// Uit welke keuken het komt, bijv. "Italiaans". Kolom in plaats van een
  /// veld in `data`, omdat er op gefilterd wordt.
  cuisine String?

  favorite Boolean @default(false)

  shareItemId String?    @unique
  shareItem   ShareItem? @relation(fields: [shareItemId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Eén gedeelde boodschappenlijst. Twee mensen, één huishouden, één lijst —
/// een aparte lijst per persoon zou alleen maar betekenen dat je allebei
/// dezelfde uien koopt.
model ShoppingItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Zoals het op de lijst staat: "ui", "pecorino romano".
  name String
  /// Voor het samenvoegen: kleine letters, enkelvoud waar we het zeker weten.
  key  String

  /// null bij "naar smaak" of "een snufje".
  quantity Float?
  unit     String?

  /// Schap uit AISLES; bepaalt onder welk kopje het staat.
  aisle String

  checked Boolean @default(false)

  /// Waar het vandaan kwam, zodat je in de winkel kunt zien waarvoor het is.
  /// Vrije tekst en geen relatie: het recept mag weg zonder je lijst te slopen.
  fromRecipe String?

  @@index([checked, aisle])
}

/// Kleine sleutel-waardetabel voor voorkeuren die niet bij één recept horen,
/// zoals de gekozen supermarkt. Gedeeld, net als de lijst zelf.
model Setting {
  key   String @id
  value String
}

/// Gevonden supermarktproduct bij een ingrediënt.
///
/// Dit is de cache die het snel houdt: opzoeken duurt een seconde, teruglezen
/// een milliseconde, en uien komen in elk tweede recept voor. Ook een misser
/// wordt bewaard — anders zoek je elke keer opnieuw naar iets dat er niet is.
model ProductMatch {
  id    String @id @default(cuid())
  store String
  /// Genormaliseerde ingrediëntnaam, dezelfde sleutel als op de lijst.
  key   String

  found      Boolean @default(true)
  productId  String?
  title      String?
  brand      String?
  priceCents Int?
  /// "per stuk", "1 kg" — wat AH naast de prijs zet.
  unitInfo   String?
  imageUrl   String?
  url        String?

  /// Welke aanpak het opleverde: jsonld | embedded | dom | browser | none.
  strategy String
  /// Hoe lang het ophalen duurde, in milliseconden. Voor de diagnose.
  ms       Int      @default(0)

  fetchedAt DateTime @default(now())

  @@unique([store, key])
}
